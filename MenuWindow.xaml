        Description:
        Defines the main menu layout and navigation buttons.-->    
   
    <Window x:Class="_30118752_AT2._3_GUI1.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_30118752_AT2._3_GUI1"
        mc:Ignorable="d"
        Title="MenuWindow" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="RoundedBlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2457A7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            
            <!-- Create rounded corners and button effects -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Change the colour when the button is used -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3478D4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#193D75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Main background and menu layout -->
    <Grid Background="#F2F4F7">
        
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="460">
            
            <!-- Main menu title -->
            <TextBlock Text="Assessment Tracker"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#202A38"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>
                
            <!-- Arrange the buttons in two rows and two columns -->
            <Grid>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- View Assessments -->
                <Button x:Name="btnViewAssessments"
                        Content="View Assessments"
                        Height="60"
                        Margin="5"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource RoundedBlueButton}"
                        Click="btnViewAssessments_Click"/>
                
                <!-- Add Assessment -->
                <Button x:Name="btnAddAssessment"
                        Content="Add Assessment"
                        Height="60"
                        Margin="5"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource RoundedBlueButton}"
                        Click="btnAddAssessment_Click"/>
                
                <!-- Delete Assessment -->
                <Button x:Name="btnDeleteAssessment"
                        Content="Delete Assessment"
                        Height="60"
                        Margin="5"
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource RoundedBlueButton}"
                        Click="btnDeleteAssessment_Click"/>
                
                <!-- Future Feature Button Placeholder -->
                <Button x:Name="btnFutureFeature"
                        Content="Future Feature"
                        Height="60"
                        Margin="5"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource RoundedBlueButton}"/>
            </Grid>

        </StackPanel>
        
    </Grid>
</Window>
