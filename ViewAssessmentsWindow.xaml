     File: ViewAssessmentsWindow.xaml
 
     Description:
     Defines the table used to display saved assessments.-->

<Window x:Class="_30118752_AT2._3_GUI1.ViewAssessmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_30118752_AT2._3_GUI1"
        mc:Ignorable="d"
        Title="View Assessments" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <Style x:Key="RoundedBlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2457A7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Create rounded corners and button effects -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="8">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <!-- Change the colour when the button is used -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#3478D4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#193D75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Background="#F2F4F7" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Screen Title -->
        <TextBlock Grid.Row="0"
                   Text="View Assessments"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#202A38"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
        
        <!-- Table Containing Assessment Records -->
        <DataGrid x:Name="dgvAssessments"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Margin="0,0,0,20">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Unit"
                                    Binding="{Binding UnitName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Assessment"
                                    Binding="{Binding AssessmentName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Assessment Type"
                                    Binding="{Binding AssessmentType}"
                                    Width="*"/>

                <DataGridTextColumn Header="Due Date"
                                    Binding="{Binding DueDate, StringFormat={}{0:dd-MM-yyyy}}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Return to Main Menu -->
        <Button x:Name="btnReturnToMenu"
                Grid.Row="2"
                Content="Return to Menu"
                Width="180"
                Height="45"
                HorizontalAlignment="Center"
                Style="{StaticResource RoundedBlueButton}"
                Click="btnReturnToMenu_Click"/>

    </Grid>
</Window>
