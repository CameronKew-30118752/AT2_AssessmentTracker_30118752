     File: AddAssessmentWindow.xaml
 
     Description:
     Defines the input fields and controls for adding assessments.-->

<Window x:Class="_30118752_AT2._3_GUI1.AddAssessmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_30118752_AT2._3_GUI1"
        mc:Ignorable="d"
        Title="Add Assessment" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="RoundedBlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2457A7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Create rounded corners and button effects -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="8">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                        </Border>

                        <!-- Change the colour when the button is used -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#3478D4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#193D75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F2F4F7" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Window Heading -->
        <TextBlock Grid.Row="0"
                   Text="Add Assessment"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="Black"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>
        
        <!-- Assessment Input Fields -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="30"
                Margin="40,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Unit / Cluster Name:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtUnitName"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="5"
                         Background="White"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Padding="8,4"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Assessment Name:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtAssessmentName"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="5"
                         Background="White"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Padding="8,4"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Assessment Type:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="cmbAssessmentType"
                          Grid.Row="2"
                          Grid.Column="1"
                          Height="32"
                          VerticalContentAlignment="Center"
                          Margin="5"
                          Background="White"
                          BorderBrush="#D1D5DB"
                          BorderThickness="1"
                          Padding="6,3">
                    <ComboBoxItem Content="Portfolio of Tasks"/>
                    <ComboBoxItem Content="Knowledge Questions"/>
                    <ComboBoxItem Content="Project"/>
                </ComboBox>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Due Date"
                           VerticalAlignment="center"
                           FontWeight="SemiBold"/>

                <DatePicker x:Name="dpDueDate"
                            Grid.Row="3"
                            Grid.Column="1"
                            Height="32"
                            Margin="5"
                            VerticalAlignment="Center"
                            SelectedDateFormat="Short"
                            ToolTip="Select the assessment due date from the calendar"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"/>
            </Grid>
        </Border>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,5">
            <Button x:Name="btnAddAssessment"
                    Content="Add Assessment"
                    Width="160"
                    Height="42"
                    Margin="0,0,12,0"
                    Style="{StaticResource RoundedBlueButton}"
                    Click="btnAddAssessment_Click"/>

            <Button x:Name="btnReturnToMenu"
                    Content="Return to Menu"
                    Width="140"
                    Height="42"
                    Style="{StaticResource RoundedBlueButton}"
                    Click="btnReturnToMenu_Click"/>
        </StackPanel>

    </Grid>
</Window>
